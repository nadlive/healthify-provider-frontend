# Stage 1: Build the Expo web app (same pattern as frontend, /provider/* SSM in buildspec)
FROM public.ecr.aws/docker/library/node:20-alpine AS build
WORKDIR /app
ARG EXPO_PUBLIC_API
ARG EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
ARG EXPO_PUBLIC_SIGNALING_SERVER
ENV EXPO_PUBLIC_API=$EXPO_PUBLIC_API
ENV EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=$EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
ENV EXPO_PUBLIC_SIGNALING_SERVER=$EXPO_PUBLIC_SIGNALING_SERVER
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx expo export --platform web --output-dir dist

# Stage 2: Serve with Nginx (same base image and pattern as frontend)
FROM public.ecr.aws/docker/library/nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8081
